[Unit]
Description=Podcast2Article
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=podcast2article
Group=podcast2article
WorkingDirectory=/opt/podcast2article/current
EnvironmentFile=/etc/podcast2article.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --max-old-space-size=384 dist/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
ReadWritePaths=/var/lib/podcast2article

[Install]
WantedBy=multi-user.target
