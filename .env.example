# Geef deze variabele via je CLI mee; sla productie-sleutels niet op in Git.
OPENAI_API_KEY=

# Optionele instellingen
OPENAI_REGION=global
PORT=3000
ARTICLE_MODEL=gpt-5.6-terra
TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
MAX_AUDIO_MB=500
MAX_YOUTUBE_MB=500
MAX_RECORDING_MB=1500
YOUTUBE_METADATA_TIMEOUT_MS=60000
MEDIA_DOWNLOAD_TIMEOUT_MS=900000
AUDIO_CHUNK_SECONDS=300
OPENAI_TRANSCRIPTION_TIMEOUT_MS=600000
OPENAI_ARTICLE_TIMEOUT_MS=600000

# Zet alleen tijdelijk aan voor volledige foutstacks in de CLI.
LOG_STACKS=false
