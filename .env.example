# Supply this variable through your CLI; never commit production keys.
OPENAI_API_KEY=

# JSON object with a unique password of at least 16 characters per user.
# Leave empty to disable authentication for local development.
APP_USERS=

# Comma-separated accounts exempt from the spending limit; costs remain tracked.
SPENDING_LIMIT_EXEMPT_USERS=

# Optional settings
OPENAI_REGION=global
HOST=127.0.0.1
PORT=3000
ARTICLE_MODEL=gpt-5.6-terra
# Three Flex attempts, then up to three standard attempts on transient failures.
# Set default to disable Flex.
ARTICLE_SERVICE_TIER=flex
TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
MAX_AUDIO_MB=500
MAX_YOUTUBE_MB=500
MAX_RECORDING_MB=1500
YOUTUBE_METADATA_TIMEOUT_MS=60000
MEDIA_DOWNLOAD_TIMEOUT_MS=900000
# Optional: absolute path to a separately installed FFmpeg executable.
# FFMPEG_BIN=/opt/podcast2article/tools/<version>/bin/ffmpeg
AUDIO_CHUNK_SECONDS=300
OPENAI_TRANSCRIPTION_TIMEOUT_MS=600000
OPENAI_ARTICLE_TIMEOUT_MS=600000

# Enable temporarily to show full error stacks in the CLI.
LOG_STACKS=false
# Canonical externally reachable origin used in permalinks and Open Graph URLs.
# PUBLIC_BASE_URL=https://podcast2article.example.com

# Optional private AWS S3 backups of final articles (no audio or transcripts).
# Enable only after configuring the bucket as described in docs/ARTICLE-BACKUPS.md.
ARTICLE_BACKUP_BUCKET=
ARTICLE_BACKUP_REGION=eu-west-1
ARTICLE_BACKUP_PREFIX=articles
# Standard AWS credential chain; omit these when using an IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
