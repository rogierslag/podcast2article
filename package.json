{
  "name": "podcast2article",
  "version": "0.1.0",
  "private": true,
  "description": "Turn public Spotify episodes, YouTube videos, and Google Meet recordings into source-linked blog articles.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "test": "vitest run && node --test scripts/github-webhook-server.node-test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src public scripts eslint.config.js",
    "lint:fix": "npm run lint -- --fix",
    "check": "npm run format:check && npm run lint && npm run build && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.1.0",
    "fast-xml-parser": "^5.2.5",
    "ffmpeg-static": "^5.2.0",
    "openai": "^5.12.2",
    "pdfkit": "^0.19.1",
    "youtube-dl-exec": "^3.1.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.14",
    "@types/pdfkit": "^0.17.6",
    "eslint": "^10.9.1",
    "prettier": "3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.4"
  }
}
