{
  "name": "podcast2article",
  "version": "0.1.0",
  "private": true,
  "description": "Turn public Spotify episodes, YouTube videos, and Google Meet recordings into source-linked blog articles.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "test": "vitest run && node --test scripts/*.node-test.mjs",
    "check:media": "node scripts/media-smoke.mjs .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src public scripts eslint.config.js",
    "lint:fix": "npm run lint -- --fix",
    "check": "npm run format:check && npm run lint && npm run build && npm test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1",
    "ffmpeg-static": "^5.3.0",
    "openai": "^7.9.0",
    "pdfkit": "^0.20.2",
    "youtube-dl-exec": "^3.1.14",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/pdfkit": "^0.17.6",
    "eslint": "^10.9.1",
    "prettier": "3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "resolutions": {
    "qs": "^6.16.0"
  }
}
