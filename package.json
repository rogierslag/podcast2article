{
  "name": "podcast2article",
  "version": "0.1.0",
  "private": true,
  "description": "Turn public Spotify episodes, YouTube videos, and Google Meet recordings into source-linked blog articles.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "test": "vitest run && node --test scripts/*.node-test.mjs",
    "check:media": "node scripts/media-smoke.mjs .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src public scripts eslint.config.js playwright.config.js",
    "lint:fix": "yarn run lint --fix",
    "check": "yarn run format:check && yarn run lint && yarn run build && yarn test",
    "test:browser": "yarn run build && playwright test",
    "backup:articles": "node --env-file-if-exists=.env dist/commands/article-backups.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "entities": "^7.0.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1",
    "ffmpeg-static": "^5.3.0",
    "openai": "^7.9.0",
    "pdfkit": "^0.20.2",
    "youtube-dl-exec": "^3.1.14",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.6",
    "@types/pdfkit": "^0.17.6",
    "eslint": "^10.9.1",
    "prettier": "3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "resolutions": {
    "qs": "^6.16.0"
  },
  "packageManager": "yarn@1.22.22"
}
