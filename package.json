{
  "name": "podcast2article",
  "version": "0.1.0",
  "private": true,
  "description": "Turn public Spotify episodes, YouTube videos, and Google Meet recordings into source-linked blog articles.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "test": "vitest run",
    "check": "npm run build && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.1.0",
    "fast-xml-parser": "^5.2.5",
    "ffmpeg-static": "^5.2.0",
    "openai": "^5.12.2",
    "youtube-dl-exec": "^3.1.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.14",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
